# These env vars override ~/.config/das/config.yml (dir: $DAS_CONFIG_DIR). Unset = use the file.
# Comma-separated root folders to scan for git projects
PROJECT_ROOTS=~/Projects
# HTTP API and WebSocket (/v1/ws) share this port
PORT=5777
# Bearer token for /v1/* (leave empty to disable auth, LAN-only dev)
TOKEN=

# Voice router
OPENROUTER_API_KEY=
CLAUDE_BIN=claude
ACT_THRESHOLD=0.8
ASK_THRESHOLD=0.4
DECISIONS_LOG=./data/decisions.jsonl

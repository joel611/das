{
  "name": "stack-chan-server",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/vendor-stack-chan.mjs",
    "dev": "vp run -r --parallel dev:all",
    "daemon": "bun packages/cli/src/daemon.ts",
    "desktop": "bun run --cwd packages/desktop tauri dev",
    "mod:build": "bun run --cwd packages/stackchan-mod mod:build",
    "mod:install": "bun run --cwd packages/stackchan-mod mod:build --install",
    "test": "vp run -r test",
    "check": "vp check",
    "ready": "vp check && vp run -r test && vp run -r build"
  },
  "devDependencies": {
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vite": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "catalog": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
    "vite-plus": "1.1.0"
  }
}

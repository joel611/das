{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stack-chan",
  "version": "0.1.0",
  "identifier": "dev.joelchan.stackchan",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "externalBin": ["binaries/stack-chan-server"]
  }
}
